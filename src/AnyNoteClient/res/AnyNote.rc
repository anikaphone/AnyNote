#include <windows.h>
#include "resource.h"

// 应用程序图标 (第一个定义的图标自动作为 exe 外壳图标)
IDI_APP_ICON ICON "AnyNote.ico"

// 主菜单
IDR_MAIN_MENU MENU
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "新建同级笔记(&N)\tCtrl+N",     ID_FILE_NEW_NOTE
        MENUITEM "新建子笔记(&S)\tCtrl+Shift+N", ID_FILE_NEW_SUB_NOTE
        MENUITEM "重命名笔记(&R)\tF2",           ID_FILE_RENAME_NOTE
        MENUITEM "删除选中笔记(&D)\tDel",         ID_FILE_DELETE_NOTE
        MENUITEM SEPARATOR
        MENUITEM "新建笔记本库(&B)...",             ID_FILE_NEW_NOTEBOOK
        MENUITEM "打开外部笔记本库(&O)...",         ID_FILE_OPEN_NOTEBOOK
        MENUITEM "管理笔记本库(&M)...",             ID_FILE_MANAGE_VAULTS
        MENUITEM "保存笔记本(&S)\tCtrl+S",        ID_FILE_SAVE
        MENUITEM SEPARATOR
        MENUITEM "退出(&X)\tAlt+F4",             ID_FILE_EXIT
    END

    POPUP "云同步(&C)"
    BEGIN
        MENUITEM "登录/注册(&L)...", ID_CLOUD_ACCOUNT
        MENUITEM "全库上传(&U)...", ID_CLOUD_UPLOAD
        MENUITEM "全库下载(&D)...", ID_CLOUD_DOWNLOAD
        MENUITEM "在线管理(&M)...", ID_CLOUD_MANAGE
    END

    POPUP "编辑(&E)"
    BEGIN
        MENUITEM "撤销(&U)\tCtrl+Z",             ID_EDIT_UNDO
        MENUITEM "恢复(&R)\tCtrl+Y",             ID_EDIT_REDO
        MENUITEM SEPARATOR
        MENUITEM "剪切(&T)\tCtrl+X",             ID_EDIT_CUT
        MENUITEM "复制(&C)\tCtrl+C",             ID_EDIT_COPY
        MENUITEM "粘贴(&P)\tCtrl+V",             ID_EDIT_PASTE
        MENUITEM SEPARATOR
        MENUITEM "全选(&A)\tCtrl+A",             ID_EDIT_SELECTALL
    END

    POPUP "视图(&V)"
    BEGIN
        MENUITEM "大纲目录(&O)\tCtrl+Shift+O",   ID_VIEW_OUTLINE
    END

    POPUP "搜索(&S)"
    BEGIN
        MENUITEM "搜索节点(&P)...\tCtrl+P",       ID_TREE_SEARCH
        MENUITEM SEPARATOR
        MENUITEM "查找(&F)...\tCtrl+F",           ID_EDIT_FIND
        MENUITEM "替换(&R)...\tCtrl+H",           ID_EDIT_REPLACE
        MENUITEM "标记(&M)...\tCtrl+M",           ID_EDIT_MARK
        MENUITEM "查找下一个\tF3",                 ID_EDIT_FIND_NEXT
        MENUITEM "查找上一个\tShift+F3",            ID_EDIT_FIND_PREV
        MENUITEM SEPARATOR
        MENUITEM "全库笔记搜索(&G)...\tCtrl+Shift+F", ID_SEARCH_GLOBAL
    END

    POPUP "格式(&O)"
    BEGIN
        MENUITEM "正文(&0)\tCtrl+0",             ID_FORMAT_HEADING_0
        MENUITEM "标题 1(&1)\tCtrl+1",           ID_FORMAT_HEADING_1
        MENUITEM "标题 2(&2)\tCtrl+2",           ID_FORMAT_HEADING_2
        MENUITEM "标题 3(&3)\tCtrl+3",           ID_FORMAT_HEADING_3
        MENUITEM "标题 4(&4)\tCtrl+4",           ID_FORMAT_HEADING_4
        MENUITEM SEPARATOR
        MENUITEM "粗体(&B)\tCtrl+B",             ID_FORMAT_BOLD
        MENUITEM "斜体(&I)\tCtrl+I",             ID_FORMAT_ITALIC
        MENUITEM "下划线(&U)\tCtrl+U",           ID_FORMAT_UNDERLINE
        MENUITEM "删除线(&S)",                   ID_FORMAT_STRIKE
    END

    POPUP "插入(&I)"
    BEGIN
        MENUITEM "插入表格(3×2)(&T)\tCtrl+Shift+T", ID_INSERT_TABLE
        MENUITEM SEPARATOR
        MENUITEM "插入代码块(&C)\tCtrl+K",        ID_FORMAT_CODE_BLOCK
        MENUITEM SEPARATOR
        MENUITEM "项目符号列表(&L)",             ID_FORMAT_BULLET_LIST
        MENUITEM "编号列表(&N)",                 ID_FORMAT_NUMBER_LIST
        MENUITEM SEPARATOR
        MENUITEM "插入图片(&P)...",              ID_INSERT_IMAGE
        MENUITEM "插入当前日期时间(&D)",          ID_INSERT_DATETIME
    END

    POPUP "安全(&S)"
    BEGIN
        MENUITEM "设置 / 修改笔记本密码(&P)...",  ID_SECURITY_ENCRYPT
    END

    POPUP "帮助(&H)"
    BEGIN
        MENUITEM "窗口置顶(&T)",                  ID_HELP_ALWAYS_ON_TOP
        MENUITEM SEPARATOR
        MENUITEM "关于 AnyNote(&A)...",          ID_HELP_ABOUT
    END
END

IDD_SYNC_PROGRESS DIALOGEX 0, 0, 310, 86
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "云同步"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "正在处理，请稍候…", IDC_SYNC_STATUS, 12, 12, 286, 35
    PUSHBUTTON "取消", IDCANCEL, 238, 59, 60, 18
END

IDD_SYNC_TEXT DIALOGEX 0, 0, 340, 100
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "输入"
FONT 9, "Microsoft YaHei UI"
BEGIN
    EDITTEXT IDC_SYNC_INPUT, 12, 12, 316, 48, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "确定", IDOK, 194, 72, 60, 18
    PUSHBUTTON "取消", IDCANCEL, 268, 72, 60, 18
END

IDD_SYNC_CHOOSE DIALOGEX 0, 0, 420, 190
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "选择本地副本"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LISTBOX IDC_SYNC_LIST, 12, 12, 396, 140, LBS_NOTIFY | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "选择", IDOK, 274, 162, 60, 18
    PUSHBUTTON "取消", IDCANCEL, 348, 162, 60, 18
END

IDD_SYNC_ACCOUNT DIALOGEX 0, 0, 300, 194
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "云同步账户"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT "服务器地址(&S):", IDC_STATIC, 12, 12, 58, 10
    EDITTEXT IDC_SYNC_URL, 74, 10, 214, 14, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT "专用证书(&C):", IDC_STATIC, 12, 30, 58, 10
    EDITTEXT IDC_SYNC_CA, 74, 28, 166, 14, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON "浏览…(&B)", IDC_SYNC_BROWSE, 244, 28, 44, 14
    CONTROL "", IDC_SYNC_TAB, "SysTabControl32", WS_TABSTOP, 12, 48, 276, 108
    LTEXT "账号(&A):", IDC_STATIC, 24, 70, 46, 10
    EDITTEXT IDC_SYNC_USER, 74, 68, 202, 14, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT "密码(&P):", IDC_SYNC_PASSWORD_LABEL, 24, 88, 46, 10
    EDITTEXT IDC_SYNC_PASSWORD, 74, 86, 202, 14, ES_PASSWORD | ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT "新密码(&N):", IDC_SYNC_NEW_LABEL, 24, 106, 46, 10
    EDITTEXT IDC_SYNC_NEW_PASSWORD, 74, 104, 202, 14, ES_PASSWORD | ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    AUTOCHECKBOX "记住密码", IDC_SYNC_REMEMBER, 74, 106, 56, 12
    AUTOCHECKBOX "自动登录", IDC_SYNC_AUTO, 136, 106, 56, 12
    DEFPUSHBUTTON "登录", IDC_SYNC_EXECUTE, 224, 130, 52, 16
    LTEXT "尚未登录", IDC_SYNC_STATUS, 12, 162, 156, 24
    PUSHBUTTON "退出登录", IDC_SYNC_LOGOUT, 174, 168, 54, 16
    PUSHBUTTON "关闭(&C)", IDCANCEL, 234, 168, 54, 16
END

IDD_SYNC_MANAGE DIALOGEX 0, 0, 460, 260
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "在线管理"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL "", IDC_SYNC_TAB, "SysTabControl32", WS_TABSTOP, 10, 8, 440, 218
    CONTROL "", IDC_SYNC_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 18, 28, 424, 190
    PUSHBUTTON "返回库列表(&B)", IDC_SYNC_BACK, 18, 28, 64, 15
    CONTROL "", IDC_SYNC_TREE, "SysTreeView32", TVS_HASLINES | TVS_HASBUTTONS | TVS_LINESATROOT | TVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 18, 46, 140, 172
    CONTROL "", IDC_SYNC_DIFF, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 164, 46, 278, 172
    LTEXT "右键或 Shift+F10 操作；差异按 sync_id 比较。", IDC_SYNC_STATUS, 10, 236, 230, 14
    PUSHBUTTON "查询未确认结果(&Q)", IDC_SYNC_QUERY, 246, 234, 88, 16
    PUSHBUTTON "刷新(&R)", IDC_SYNC_REFRESH, 340, 234, 50, 16
    PUSHBUTTON "关闭(&C)", IDCANCEL, 396, 234, 54, 16
END

// 快捷键表
IDR_ACCELERATOR ACCELERATORS
BEGIN
    "0", ID_FORMAT_HEADING_0,   VIRTKEY, CONTROL
    "1", ID_FORMAT_HEADING_1,   VIRTKEY, CONTROL
    "2", ID_FORMAT_HEADING_2,   VIRTKEY, CONTROL
    "3", ID_FORMAT_HEADING_3,   VIRTKEY, CONTROL
    "4", ID_FORMAT_HEADING_4,   VIRTKEY, CONTROL
    "N", ID_FILE_NEW_NOTE,      VIRTKEY, CONTROL
    "N", ID_FILE_NEW_SUB_NOTE,  VIRTKEY, CONTROL, SHIFT
    "S", ID_FILE_SAVE,          VIRTKEY, CONTROL
    VK_F2, ID_FILE_RENAME_NOTE, VIRTKEY
    "Z", ID_EDIT_UNDO,          VIRTKEY, CONTROL
    "Y", ID_EDIT_REDO,          VIRTKEY, CONTROL
    "B", ID_FORMAT_BOLD,        VIRTKEY, CONTROL
    "I", ID_FORMAT_ITALIC,      VIRTKEY, CONTROL
    "U", ID_FORMAT_UNDERLINE,   VIRTKEY, CONTROL
    "K", ID_FORMAT_CODE_BLOCK,  VIRTKEY, CONTROL
    "T", ID_INSERT_TABLE,       VIRTKEY, CONTROL, SHIFT
    "F", ID_EDIT_FIND,          VIRTKEY, CONTROL
    "H", ID_EDIT_REPLACE,       VIRTKEY, CONTROL
    "M", ID_EDIT_MARK,          VIRTKEY, CONTROL
    VK_F3, ID_EDIT_FIND_NEXT,   VIRTKEY
    VK_F3, ID_EDIT_FIND_PREV,   VIRTKEY, SHIFT
    "F", ID_SEARCH_GLOBAL,      VIRTKEY, CONTROL, SHIFT
    "P", ID_TREE_SEARCH,        VIRTKEY, CONTROL
    "O", ID_VIEW_OUTLINE,       VIRTKEY, CONTROL, SHIFT
END

// 插入代码块对话框
IDD_INSERT_CODE DIALOGEX 0, 0, 360, 240
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "插入代码块 (CodeBox)"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "代码语言(&L):", IDC_STATIC, 12, 12, 50, 10
    COMBOBOX        IDC_CODE_LANG, 68, 10, 130, 140, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "代码内容(&C):", IDC_STATIC, 12, 30, 50, 10
    EDITTEXT        IDC_CODE_TEXT, 12, 42, 336, 162, ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_HSCROLL | WS_BORDER | WS_TABSTOP
    DEFPUSHBUTTON   "插入代码块(&I)", IDOK, 218, 214, 64, 16
    PUSHBUTTON      "取消(&C)", IDCANCEL, 288, 214, 60, 16
END

// 设置/修改密码对话框
IDD_SET_PASSWORD DIALOGEX 0, 0, 240, 140
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "设置 / 修改笔记本密码"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "新密码(&P) (留空表示解除加密):", IDC_STATIC, 16, 14, 208, 10
    EDITTEXT        IDC_PASSWORD_NEW, 16, 26, 208, 14, ES_PASSWORD | ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "确认新密码(&C):", IDC_STATIC, 16, 48, 208, 10
    EDITTEXT        IDC_PASSWORD_CONFIRM, 16, 60, 208, 14, ES_PASSWORD | ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "提示：若设置密码，整个数据库将以 AES-256 加密保存。请务必牢记密码！", IDC_STATIC, 16, 82, 208, 24
    DEFPUSHBUTTON   "确定(&O)", IDOK, 112, 114, 52, 16
    PUSHBUTTON      "取消(&C)", IDCANCEL, 172, 114, 52, 16
END

// 输入密码解密对话框
IDD_ENTER_PASSWORD DIALOGEX 0, 0, 240, 95
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "输入笔记本密码"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "该笔记本已加密，请输入密码解密打开：", IDC_STATIC, 16, 14, 208, 10
    EDITTEXT        IDC_PASSWORD_INPUT, 16, 28, 208, 14, ES_PASSWORD | ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    DEFPUSHBUTTON   "确定(&O)", IDOK, 112, 66, 52, 16
    PUSHBUTTON      "取消(&C)", IDCANCEL, 172, 66, 52, 16
END

// 新建笔记本库对话框
IDD_NEW_VAULT DIALOGEX 0, 0, 260, 115
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "新建笔记本库"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "库名称(&N):", IDC_STATIC, 16, 14, 228, 10
    EDITTEXT        IDC_NEW_VAULT_NAME, 16, 26, 228, 14, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "保存路径 (自动生成于 notebooks/ 目录):", IDC_STATIC, 16, 46, 228, 10
    EDITTEXT        IDC_NEW_VAULT_PATH, 16, 58, 228, 14, ES_AUTOHSCROLL | ES_READONLY | WS_BORDER
    DEFPUSHBUTTON   "创建(&C)", IDOK, 132, 88, 52, 16
    PUSHBUTTON      "取消", IDCANCEL, 192, 88, 52, 16
END

// 管理笔记本库对话框
IDD_MANAGE_VAULTS DIALOGEX 0, 0, 400, 230
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "管理笔记本库"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "已注册笔记本库列表：", IDC_STATIC, 12, 10, 270, 10
    CONTROL         "", IDC_VAULT_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 12, 22, 280, 170
    PUSHBUTTON      "新建库(&N)...", IDC_VAULT_BTN_NEW, 304, 22, 84, 16
    PUSHBUTTON      "重命名(&R)...", IDC_VAULT_BTN_RENAME, 304, 44, 84, 16
    PUSHBUTTON      "从列表移除(&D)", IDC_VAULT_BTN_REMOVE, 304, 66, 84, 16
    PUSHBUTTON      "打开所在位置(&O)", IDC_VAULT_BTN_EXPLORER, 304, 88, 84, 16
    DEFPUSHBUTTON   "切换到选中库(&S)", IDC_VAULT_BTN_SWITCH, 304, 176, 84, 16
    LTEXT           "提示：从列表移除仅移出配置，不会删除硬盘上的实际数据库文件。", IDC_STATIC, 12, 202, 280, 16
    PUSHBUTTON      "关闭(&C)", IDCANCEL, 304, 200, 84, 16
END

// 重命名笔记本库对话框
IDD_RENAME_VAULT DIALOGEX 0, 0, 220, 80
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "重命名笔记本库"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "输入新的库显示名称(&N):", IDC_STATIC, 14, 12, 192, 10
    EDITTEXT        IDC_RENAME_VAULT_INPUT, 14, 26, 192, 14, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    DEFPUSHBUTTON   "确定(&O)", IDOK, 96, 52, 50, 16
    PUSHBUTTON      "取消(&C)", IDCANCEL, 154, 52, 50, 16
END

